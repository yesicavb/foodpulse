# Copy this file to .env.local and fill in the two values from your Supabase project
# (Project Settings -> API, or the "Connect" button at the top of the dashboard).
# On Vercel, add the same two variables under Project -> Settings -> Environment Variables.
#
# Leave them empty to run the app without a database (everything saved in the browser).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
